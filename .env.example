# Public base URL, used for absolute links in the RSS feed and share metadata
SITE_URL=https://example.com

# AC Milan fixtures: free key from https://www.football-data.org/client/register (server-side only)
FOOTBALL_DATA_TOKEN=

# Reading Radar: cache lifetime and the token a scheduler sends to force a refresh
RADAR_TTL_HOURS=24
RADAR_REFRESH_TOKEN=

# Vercel Cron sends this automatically when set in the project (any random string)
CRON_SECRET=
